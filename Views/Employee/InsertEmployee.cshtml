@{
    // Set the page title and assign the layout for this view
    ViewData["Title"] = "Insert Employee";
    Layout = "_Layout_Employee_InsertEmployee";
}

@model Employee

<!-- Page Heading -->
<h2>Create a New Employee</h2>

@* @if (ViewData["ErrorMessage"] != null)
{
    <p class="text-center text-bg-danger mt-3 p-2">
        @ViewData["ErrorMessage"]
    </p>
} *@

<!-- Form to submit employee data to InsertEmployeeToDatabase action in EmployeeController, using POST method -->
@using (Html.BeginForm("InsertEmployeeToDatabase", "Employee", "Post"))
{
    <!-- EmployeeId -->
    <input asp-for="EmployeeId" type="hidden" value=""/>

    <!-- Name: First, Middle, Last -->
    <label asp-for="FirstName" class="control-label">First Name</label>
    <input type="text" name="FirstName" class="form-control" value="" placeholder="Example: John"/>

    <label asp-for="MiddleName" class="control-label">Middle Name</label>
    <input type="text" name="MiddleName" class="form-control" placeholder="Example: Michael"/>

    <label asp-for="LastName" class="control-label">Last Name</label>
    <input type="text" name="LastName" class="form-control" placeholder="Example: Smith"/>

    <!-- Birth Information -->
    <label asp-for="BirthDay" class="control-label">Birth Day</label>
    <input type="number" name="BirthDay" class="form-control" placeholder="Example: 1"/>

    <label asp-for="BirthMonth" class="control-label">Birth Month</label>
    <input type="number" name="BirthMonth" class="form-control" placeholder="Example: 1" />

    <label asp-for="BirthYear" class="control-label">Birth Year</label>
    <input type="number" name="BirthYear" class="form-control" placeholder="Example: 1985"/>

    <!-- Age -->
    <label asp-for="Age" class="control-label">Age</label>
    <input type="number" name="Age" class="form-control" placeholder="Example: 39"/>

    <!-- Contact Information -->
    <label asp-for="PhoneNumber" class="control-label">Phone Number</label>
    <input type="text" name="PhoneNumber" class="form-control" placeholder="Example: 555-555-5555"/>

    <label asp-for="EmailAddress" class="control-label">Email Address</label>
    <input type="email" name="EmailAddress" class="form-control" placeholder="Example: JohnSmith@AnEmail.com"/>

    <label asp-for="HomeAddress" class="control-label">Home Address</label>
    <input type="text" name="HomeAddress" class="form-control" placeholder="Example: 1234 JohnSmith Way"/>

    <!-- Current Position -->
    <label asp-for="EmployeeDepartment" class="control-label">Department</label>
    <input type="text" name="EmployeeDepartment" class="form-control" placeholder="Example: Electronics"/>

    <label asp-for="EmployeeTitle" class="control-label">Title</label>
    <input type="number" name="EmployeeTitle" class="form-control" placeholder="Example: 1"/>

    <label asp-for="PayRate" class="control-label">Pay Rate</label>
    <input type="number" name="PayRate" class="form-control" placeholder="Example: 20.00"/>

    <label asp-for="HoursWorked" class="control-label">Hours Worked</label>
    <input type="number" name="HoursWorked" class="form-control" placeholder="Example: 0"/>

    <!-- Submit -->
    <input type="submit" value="Create Employee" class="btn btn-primary"/>
}