@{
    // Set the page title and assign the layout for this view
    ViewData["Title"] = "Update Employee";
    
}

@model Employee

<!-- Page Heading -->
<h2>Update Employee</h2>

<!-- Form to submit updated employee data to UpdateEmployeeToDatabase action in EmployeeController, using POST method -->
@using (Html.BeginForm("UpdateEmployeeToDatabase", "Employee", "Post"))
{
    <!-- EmployeeId -->
    <input asp-for="EmployeeId" type="hidden"/>

    <!-- asp-for: First, Middle, Last -->
    <label asp-for="FirstName" class="form-label mb-2">First Name</label>
    <input asp-for="FirstName" type="text" class="form-control mb-1" placeholder="Example: John" required />
    <div class="mb-4"><span asp-validation-for="FirstName" class="text-danger"></span></div>

    <label asp-for="MiddleName" class="form-label mb-2">Middle Name</label>
    <input asp-for="MiddleName" type="text" class="form-control mb-1" placeholder="Example: Michael" required />
    <div class="mb-4"><span asp-validation-for="MiddleName" class="text-danger"></span></div>

    <label asp-for="LastName" class="form-label mb-2">Last Name</label>
    <input asp-for="LastName" type="text" class="form-control mb-1" placeholder="Example: Smith" required />
    <div class="mb-4"><span asp-validation-for="LastName" class="text-danger"></span></div>

    <!-- Birth Information -->
    <label asp-for="BirthDay" class="form-label mb-2">Birth Day</label>
    <input type="number" asp-for="BirthDay" class="form-control mb-1" placeholder="Example: 1" />
    <div class="mb-4"><span asp-validation-for="BirthDay" class="text-danger"></span></div>

    <label asp-for="BirthMonth" class="form-label mb-2">Birth Month</label>
    <input type="number" asp-for="BirthMonth" class="form-control mb-1" placeholder="Example: 1" />
    <div class="mb-3"><span asp-validation-for="BirthMonth" class="text-danger"></span></div>

    <label asp-for="BirthYear" class="form-label mb-2">Birth Year</label>
    <input type="number" asp-for="BirthYear" class="form-control mb-1" placeholder="Example: 1985" />
    <div class="mb-3"><span asp-validation-for="BirthYear" class="text-danger"></span></div>

    <!-- Age -->
    <label asp-for="Age" class="form-label mb-2">Age</label>
    <input type="number" asp-for="Age" class="form-control mb-1" placeholder="Example: 39" />
    <div class="mb-3"><span asp-validation-for="Age" class="text-danger"></span></div>

    <!-- Contact Information -->
    <label asp-for="PhoneNumber" class="form-label mb-2">Phone Number</label>
    <input type="text" asp-for="PhoneNumber" class="form-control mb-1" placeholder="Example: 555-555-5555" />
    <div class="mb-3"><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>

    <label asp-for="EmailAddress" class="form-label mb-2">Email Address</label>
    <input type="email" asp-for="EmailAddress" class="form-control mb-1" placeholder="Example: JohnSmith@AnEmail.com" />
    <div class="mb-3"><span asp-validation-for="EmailAddress" class="text-danger"></span></div>

    <label asp-for="HomeAddress" class="form-label mb-2">Home Address</label>
    <input type="text" asp-for="HomeAddress" class="form-control mb-1" placeholder="Example: 1234 JohnSmith Way" />
    <div class="mb-3"><span asp-validation-for="HomeAddress" class="text-danger"></span></div>

    <!-- Current Position -->
    <label asp-for="EmployeeDepartment" class="form-label mb-2">Department</label>
    <input type="text" asp-for="EmployeeDepartment" class="form-control mb-1" placeholder="Example: Electronics" />
    <div class="mb-3"><span asp-validation-for="EmployeeDepartment" class="text-danger"></span></div>

    <label asp-for="EmployeeTitle" class="form-label mb-2">Title (e.g., 1 = Manager, 2 = Supervisor, etc.)</label>
    <input type="number" asp-for="EmployeeTitle" class="form-control mb-1" placeholder="Example: 1" />
    <div class="mb-3"><span asp-validation-for="EmployeeTitle" class="text-danger"></span></div>

    <label asp-for="PayRate" class="form-label mb-2">Pay Rate</label>
    <input type="number" asp-for="PayRate" class="form-control mb-1" placeholder="Example: 20.00" />
    <div class="mb-3"><span asp-validation-for="PayRate" class="text-danger"></span></div>

    <label asp-for="HoursWorked" class="form-label mb-2">Hours Worked</label>
    <input type="number" asp-for="HoursWorked" class="form-control mb-1" placeholder="Example: 0" />
    <div class="mb-3"><span asp-validation-for="HoursWorked" class="text-danger"></span></div>


    <a href="@Url.Action("Index", "Employee")" class="btn btn-secondary">Cancel</a>
    
    <!-- Submit -->
    <input type="submit" value="Update Employee" class="btn btn-primary" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}